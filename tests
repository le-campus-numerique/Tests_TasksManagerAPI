package com.example.task.service;

import com.example.task.model.Task;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import java.util.List;

import static org.assertj.core.api.Assertions.assertThat;
import static org.junit.jupiter.api.Assertions.assertThrows;

public class TaskServiceUnitTests {

    private TaskService taskService;

    @BeforeEach
    void setUp() {
        taskService = new TaskService();
    }

    // --- addTask ---

    @Test
    void addTask_should_add_task_to_the_list() {
        taskService.addTask("Faire les courses");
        assertThat(taskService.getAllTasks()).hasSize(1);
    }

    @Test
    void addTask_should_generate_unique_ids() {
        taskService.addTask("Tâche 1");
        taskService.addTask("Tâche 2");
        List<Task> tasks = taskService.getAllTasks();
        assertThat(tasks.get(0).getId()).isNotEqualTo(tasks.get(1).getId());
    }

    @Test
    void addTask_should_set_status_to_en_cours_by_default() {
        taskService.addTask("Nouvelle tâche");
        Task task = taskService.getAllTasks().get(0);
        assertThat(task.getStatus()).isEqualTo("en cours");
    }

    // --- deleteTask ---

    @Test
    void deleteTask_should_remove_task_from_list() {
        taskService.addTask("À supprimer");
        String id = taskService.getAllTasks().get(0).getId();

        taskService.deleteTask(id);

        assertThat(taskService.getAllTasks()).isEmpty();
    }

    @Test
    void deleteTask_with_unknown_id_should_throw_exception() {
        assertThrows(IllegalArgumentException.class, () -> {
            taskService.deleteTask("id-inexistant");
        });
    }

    // --- completeTask ---

    @Test
    void completeTask_should_set_status_to_termine() {
        taskService.addTask("À terminer");
        String id = taskService.getAllTasks().get(0).getId();

        taskService.completeTask(id);

        assertThat(taskService.getAllTasks().get(0).getStatus()).isEqualTo("terminé");
    }

    @Test
    void completeTask_with_unknown_id_should_throw_exception() {
        assertThrows(IllegalArgumentException.class, () -> {
            taskService.completeTask("id-inexistant");
        });
    }

    // --- getAllTasks ---

    @Test
    void getAllTasks_should_return_empty_list_initially() {
        assertThat(taskService.getAllTasks()).isEmpty();
    }

    @Test
    void getAllTasks_should_return_all_added_tasks() {
        taskService.addTask("Tâche 1");
        taskService.addTask("Tâche 2");
        assertThat(taskService.getAllTasks()).hasSize(2);
    }
}